# Copy this file to ".env" and fill in the real values.
# The .env file is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Google Gemini API key
# Get one free at https://aistudio.google.com  (no credit card required)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=paste-your-key-here

# Which model to use for extraction and adjudication.
#
# Pin an exact version. Do NOT use an alias such as "gemini-flash-latest": the
# LLM cache key contains the model name, so when an alias is silently repointed
# at a new model the key stays the same and stale answers keep being served.
#
# Free-tier limits READ FROM THE PROVIDER DASHBOARD on 2026-09-08:
#
#   gemini-3.5-flash-lite   15 req/min   500 req/day   <- the only viable one
#   gemini-3.6-flash         5 req/min    20 req/day
#   gemini-3.7-flash         5 req/min    20 req/day
#   gemini-3.8-flash         5 req/min    20 req/day
#
# Twenty requests a day cannot process a document. Flash Lite can process the
# whole corpus several times over. Save the larger models for the handful of
# hard judgements in Step 7, where quality matters and volume is tiny.
#
# gemini-2.5-flash still appears in the model list but is refused for new keys.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Supabase Postgres connection string
#
# Where to find it: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI
#
# IMPORTANT: use the "Session pooler" connection string, not the direct one.
# Supabase direct connections are IPv6-only on the free tier, and most home
# internet connections in India are IPv4. The pooler works over IPv4.
# The pooler host looks like: aws-0-<region>.pooler.supabase.com  (port 5432)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---------------------------------------------------------------------------
# Pipeline settings
# ---------------------------------------------------------------------------

# How many rows to send to the database in one write.
DATABASE_BATCH_SIZE=200

# How many LLM calls to run at the same time.
# Keep this low — the free tier limits requests per minute, not CPU.
LLM_CONCURRENT_REQUESTS=4

# How many requests per minute we allow ourselves. Set this BELOW your model's
# real limit, not at it. Flash Lite allows 15, so 12 leaves margin.
LLM_REQUESTS_PER_MINUTE=12

# Bump this string whenever you change the extraction prompt.
# It is part of the cache key, so changing it correctly invalidates old answers.
EXTRACTION_PROMPT_VERSION=v1
